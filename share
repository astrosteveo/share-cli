#!/usr/bin/env python3
"""share: put pictures and videos on the web and print a link to paste.

    share PATH [PATH ...]    upload, wait until the link works, print one link per file
    share --list             every file that is up, with its link
    share --rm TARGET ...    take files down (a link, a 10-character id or a file name)

Files go into a public GitHub repo of your own (default <you>/share, made on first use with
`gh`) and GitHub Pages serves them at https://<you>.github.io/share/f/<id>/<name>. Pages sends the
right content type, so a video plays in the browser and a picture opens in place, and your
friends need no account. The id is the start of the file's SHA-256, so sharing the same file
again gives the same link.

Things to know:
  * The repo is public. Anyone can browse it and open anything in it. Never share what you would
    not post openly.
  * A link works only once GitHub Pages has deployed it, usually 15 to 25 seconds after the push.
    This waits for it. Several paths in one call make one deploy.
  * Limits: 100 MB a file (git refuses more) and about 1 GB for the whole site.
  * Browsers play mp4 (H.264) and webm inline; .mov, .mkv and .avi may download instead.
  * --rm rewrites the repo into one fresh commit and force-pushes, so the file leaves the history
    and stops counting toward the 1 GB. GitHub may still serve the old commit by its SHA until it
    cleans up. Anything truly sensitive should not go up at all.

Links go to stdout, everything else to stderr, so `share clip.mp4 | wl-copy` works. On Wayland the
links are also copied to the clipboard. Set SHARE_REPO=owner/name to use another repo.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

sys.dont_write_bytecode = True

MAX_BYTES = 100 * 1024 * 1024
WARN_BYTES = 50 * 1024 * 1024
BUILD_TIMEOUT = 180
OTHER_VIDEO = {".mov", ".mkv", ".avi", ".wmv", ".flv"}
README = (
    "# share\n\nPictures and videos shared by link with the `share` command.\n\n"
    "This repo is public: everything in `f/` can be browsed and opened by anyone.\n"
)
# Pages' own branch build is two jobs, and the second waits for a fresh runner. One job saves about 7 s.
WORKFLOW_PATH = ".github/workflows/pages.yml"
WORKFLOW = """\
# Written by the `share` command: deploy the repo as it is, in one job.
name: pages
on:
  push:
    branches: [%s]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/upload-pages-artifact@v5
        with:
          path: .
      - id: deployment
        uses: actions/deploy-pages@v5
        with:
          reporting_interval: 1000
"""
DEPLOY_FAILED = {"deployment_failed", "deployment_content_failed", "deployment_attempt_error", "deployment_lost"}


def say(message):
    print(message, file=sys.stderr, flush=True)


def die(message):
    say("share: " + message)
    sys.exit(1)


def run(cmd, cwd=None, check=True):
    """Runs a command and returns the finished process; a failure ends the program with its message."""
    try:
        done = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    except FileNotFoundError:
        die("%s is not installed" % cmd[0])
    if check and done.returncode:
        die("`%s` failed: %s" % (" ".join(cmd[:3]), (done.stderr or done.stdout).strip()))
    return done


def git(clone, *args, check=True):
    return run(["git", "-C", str(clone), *args], check=check)


def human(size):
    for unit in ("B", "KB", "MB"):
        if size < 1024:
            return "%d %s" % (size, unit) if unit == "B" else "%.1f %s" % (size, unit)
        size /= 1024
    return "%.1f GB" % size


def clean_name(name):
    """A file name of plain ASCII letters, digits, dots, dashes and underscores, which needs no escaping in a link."""
    path = Path(name)
    stem = unicodedata.normalize("NFKD", path.stem).encode("ascii", "ignore").decode()
    stem = re.sub(r"[^A-Za-z0-9._-]+", "-", stem).strip("-.") or "file"
    suffix = re.sub(r"[^A-Za-z0-9.]", "", path.suffix).lower()
    return stem + suffix


def gh_login():
    """The gh login, read from gh's own config when it is there, which saves a call to the API."""
    login = run(["gh", "config", "get", "-h", "github.com", "user"], check=False).stdout.strip()
    return login or run(["gh", "api", "user", "--jq", ".login"]).stdout.strip()


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


class Site:
    """The clone of the share repo and the Pages site built from it."""

    def __init__(self):
        self.repo = os.environ.get("SHARE_REPO") or "%s/share" % gh_login()
        self.owner, self.name = self.repo.split("/")
        cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
        self.clone = cache / "share" / self.name
        self.base = "https://%s.github.io/%s/" % (self.owner, self.name)
        self.branch = "main"

    def url(self, ident, name):
        return "%sf/%s/%s" % (self.base, ident, urllib.parse.quote(name))

    def api(self, path):
        """The JSON gh gets for an API path, or {} if the call fails, so a poll that misses an answer tries again."""
        done = run(["gh", "api", path], check=False)
        try:
            return json.loads(done.stdout or "{}")
        except ValueError:
            return {}

    def sync(self):
        """Makes the local clone match the remote, making the repo and its Pages site the first time."""
        if not (self.clone / ".git").is_dir():
            if run(["gh", "repo", "view", self.repo], check=False).returncode:
                say("making the public repo %s (first use)" % self.repo)
                run(["gh", "repo", "create", self.repo, "--public", "--add-readme", "--description", "Files shared by link"])
            self.clone.parent.mkdir(parents=True, exist_ok=True)
            run(["gh", "repo", "clone", self.repo, str(self.clone), "--", "-q"])
        else:
            git(self.clone, "fetch", "-q", "origin")
        head = git(self.clone, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False).stdout.strip()
        self.branch = head.split("/", 1)[1] if "/" in head else "main"
        git(self.clone, "checkout", "-q", "-f", "-B", self.branch, "origin/" + self.branch)
        # The workflow is the last thing set up, so once it is in the repo there is nothing to check.
        if not (self.clone / WORKFLOW_PATH).exists():
            self.set_up_pages()

    def set_up_pages(self):
        """Has Pages deploy with the one-job workflow: on first use, and once for a repo made when `share` used the branch build."""
        say("setting up GitHub Pages to deploy in one job (once)")
        # Without this, a branch build's Jekyll skips any file whose name starts with `_` or `.`.
        if not (self.clone / ".nojekyll").exists():
            (self.clone / ".nojekyll").write_text("")
            (self.clone / "README.md").write_text(README)
        workflow = self.clone / WORKFLOW_PATH
        workflow.parent.mkdir(parents=True, exist_ok=True)
        workflow.write_text(WORKFLOW % self.branch)
        git(self.clone, "add", "-A")
        endpoint = ["gh", "api", "repos/%s/pages" % self.repo]
        pages = run(endpoint, check=False)
        undo = None
        if pages.returncode:
            run(endpoint + ["-X", "POST", "-f", "build_type=workflow"])
        elif json.loads(pages.stdout).get("build_type") != "workflow":
            # Back to the branch build if the push fails, or nothing would deploy until the workflow lands.
            undo = lambda: run(endpoint + ["-X", "PUT", "-f", "build_type=legacy"], check=False)
            run(endpoint + ["-X", "PUT", "-f", "build_type=workflow"])
        self.commit_and_push("deploy every file as it is, in one job", undo)

    def commit_and_push(self, message, undo=None):
        """One commit, pushed; if the push fails the clone goes back to the remote so it is never left ahead, and `undo` runs."""
        git(self.clone, "commit", "-q", "-m", message)
        pushed = git(self.clone, "push", "-q", "origin", "HEAD:" + self.branch, check=False)
        if pushed.returncode:
            git(self.clone, "reset", "-q", "--hard", "origin/" + self.branch)
            if undo:
                undo()
            die("the push failed: %s" % pushed.stderr.strip())
        return git(self.clone, "rev-parse", "HEAD").stdout.strip()

    def wait_for_build(self, sha):
        """Waits for Pages to deploy this commit. True when it is live, False if it is not after three minutes."""
        say("waiting for GitHub Pages to deploy...")
        started = time.time()
        polls = 0
        while time.time() - started < BUILD_TIMEOUT:
            # "succeed" comes after the CDN is purged, so the link answers at once.
            status = self.api("repos/%s/pages/deployments/%s" % (self.repo, sha)).get("status")
            if status == "succeed":
                say("live in %d s" % (time.time() - started))
                return True
            if status in DEPLOY_FAILED:
                die("the Pages deploy failed (%s)" % status)
            polls += 1
            # A run that fails before it deploys never shows above, so look at the run now and then.
            if polls % 5 == 0:
                runs = self.api("repos/%s/actions/runs?head_sha=%s" % (self.repo, sha)).get("workflow_runs") or []
                for done in runs:
                    # A newer push took its place, and that build has these files too.
                    if done.get("conclusion") == "cancelled":
                        return False
                    if done.get("status") == "completed" and done.get("conclusion") != "success":
                        die("the Pages run ended with %s: %s" % (done.get("conclusion"), done.get("html_url")))
            time.sleep(1)
        return False

    def check_live(self, url):
        """The content type if the link answers, else None. A few tries, because the CDN can lag a moment behind the build."""
        for attempt in range(5):
            try:
                request = urllib.request.Request(url, method="HEAD")
                with urllib.request.urlopen(request, timeout=15) as reply:
                    return reply.headers.get("content-type", "")
            except urllib.error.HTTPError as error:
                if error.code != 404:
                    return None
            except urllib.error.URLError:
                pass
            time.sleep(2)
        return None

    def files(self):
        """Every file that is up, as (id, name, path), in name order."""
        found = []
        for path in sorted((self.clone / "f").glob("*/*")):
            if path.is_file():
                found.append((path.parent.name, path.name, path))
        return found


def copy_to_clipboard(text):
    """Best effort. wl-copy forks a server that can hold a captured pipe open, so it gets no pipes but its input."""
    if not (os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy")):
        return False
    try:
        subprocess.run(["wl-copy"], input=text.encode(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        return True
    except Exception:
        return False


def finish(links, copy):
    print("\n".join(links), flush=True)
    if copy and copy_to_clipboard("\n".join(links)):
        say("copied to the clipboard")


def cmd_share(paths, wait, copy):
    items = []
    for raw in paths:
        path = Path(raw).expanduser()
        if not path.is_file():
            die("no such file: %s" % raw)
        size = path.stat().st_size
        if size == 0:
            die("%s is empty" % raw)
        if size > MAX_BYTES:
            die("%s is %s and GitHub takes at most 100 MB a file. Shrink it first, for example:\n"
                "  ffmpeg -i %s -crf 28 -vf scale=-2:720 smaller.mp4" % (raw, human(size), raw))
        if size > WARN_BYTES:
            say("note: %s is %s, which is big for a link" % (path.name, human(size)))
        if path.suffix.lower() in OTHER_VIDEO:
            say("note: browsers play mp4 (H.264) and webm inline; %s may download instead" % path.name)
        items.append((path, sha256(path)[:10], clean_name(path.name)))

    site = Site()
    site.sync()
    added = []
    for path, ident, name in items:
        target = site.clone / "f" / ident / name
        if not target.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(path, target)
            added.append(name)
    links = [site.url(ident, name) for _, ident, name in items]
    if added:
        say("uploading %s" % ", ".join(added))
        git(site.clone, "add", "-A")
        sha = site.commit_and_push(("add " + ", ".join(added))[:120])
        if wait and not site.wait_for_build(sha):
            say("share: the build is still running, so the links may not work for another minute")
            finish(links, copy)
            return
    if wait:
        for link in links:
            kind = site.check_live(link)
            if kind is None:
                say("share: %s does not answer yet; try it again in a minute" % link)
            else:
                say("ok  %s  (%s)" % (link.rsplit("/", 1)[-1], kind.split(";")[0]))
    finish(links, copy)


def cmd_list():
    site = Site()
    site.sync()
    found = site.files()
    if not found:
        say("nothing is up")
    for ident, name, path in found:
        print("%s  %8s  %s" % (site.url(ident, name), human(path.stat().st_size), ident))


def cmd_rm(targets, wait):
    site = Site()
    site.sync()
    found = site.files()
    ids = set()
    for target in targets:
        match = re.search(r"/f/([0-9a-f]{10})/", target)
        key = match.group(1) if match else target
        hits = {ident for ident, name, _ in found if key in (ident, name)}
        if not hits:
            die("nothing that is up matches %s" % target)
        ids |= hits
    for ident in sorted(ids):
        git(site.clone, "rm", "-rq", "f/" + ident)
    # One fresh commit of what is left, so the removed bytes leave the branch history too.
    git(site.clone, "checkout", "-q", "--orphan", "_rewrite")
    git(site.clone, "commit", "-q", "-m", "share files")
    git(site.clone, "branch", "-q", "-M", site.branch)
    pushed = git(site.clone, "push", "-q", "-f", "origin", site.branch, check=False)
    if pushed.returncode:
        git(site.clone, "reset", "-q", "--hard", "origin/" + site.branch)
        die("the push failed: %s" % pushed.stderr.strip())
    sha = git(site.clone, "rev-parse", "HEAD").stdout.strip()
    say("removed %d file(s) from the repo and its history" % len(ids))
    say("GitHub may serve the old commit by its SHA until it cleans up")
    if wait:
        site.wait_for_build(sha)


def main():
    parser = argparse.ArgumentParser(
        prog="share", description=__doc__.split("\n\n")[0], epilog="\n".join(__doc__.split("\n\n")[1:]),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("paths", nargs="*", metavar="PATH", help="files to put on the web")
    parser.add_argument("--list", action="store_true", help="list what is up, with links")
    parser.add_argument("--rm", nargs="+", metavar="TARGET", help="take files down: a link, an id or a file name")
    parser.add_argument("--no-wait", action="store_true", help="print the links without waiting for the Pages build")
    parser.add_argument("--no-copy", action="store_true", help="leave the clipboard alone")
    args = parser.parse_args()
    if args.list:
        cmd_list()
    elif args.rm:
        cmd_rm(args.rm, not args.no_wait)
    elif args.paths:
        cmd_share(args.paths, not args.no_wait, not args.no_copy)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
