DEPLOY_FAILED = {"deployment_failed", "deployment_content_failed", "deployment_attempt_error", "deployment_lost"}


def say(message):
    print(message, file=sys.stderr, flush=True)


def die(message):
    say("share: " + message)
    notify("share failed", message)
    sys.exit(1)


def notify(title, body):
    """Run from a desktop hotkey, nobody sees stderr, so how it went goes to a notification as well. Best effort."""
    if sys.stderr.isatty() or not shutil.which("notify-send"):
        return
    try:
        subprocess.run(["notify-send", "--app-name=share", title, body], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except Exception:
        pass


def run(cmd, cwd=None, check=True):
    """Runs a command and returns the finished process; a failure ends the program with its message."""
    try:
        done = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    except FileNotFoundError:
        die("%s is not installed" % cmd[0])
    if check and done.returncode:
        die("`%s` failed: %s" % (" ".join(cmd[:3]), (done.stderr or done.stdout).strip()))
    return done


def git(clone, *args, check=True):
    return run(["git", "-C", str(clone), *args], check=check)


def human(size):
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024:
            return "%d %s" % (size, unit) if unit == "B" else "%.1f %s" % (size, unit)
        size /= 1024
    return "%.1f TB" % size


def clean_name(name):
    """A file name of plain ASCII letters, digits, dots, dashes and underscores, which needs no escaping in a link."""
    path = Path(name)
    stem = unicodedata.normalize("NFKD", path.stem).encode("ascii", "ignore").decode()
    stem = re.sub(r"[^A-Za-z0-9._-]+", "-", stem).strip("-.") or "file"
    suffix = re.sub(r"[^A-Za-z0-9.]", "", path.suffix).lower()
    return stem + suffix


# A file that is up: `prefix` is the folder it is in, `f` (kept until --rm) or `<n>d` (deleted by R2 n days after it
# went up), and `modified` is when it went up.
Entry = namedtuple("Entry", "prefix ident name size modified")
# A file to put up: `path` holds its bytes, `name` is its name in the link and `original` the name it had.
Item = namedtuple("Item", "path prefix ident name digest size original")


def link(base, prefix, ident, name):
    return "%s%s/%s/%s" % (base, prefix, ident, urllib.parse.quote(name))


def parse_key(key):
    """(prefix, id, name) for a key in the layout `<prefix>/<id>/<name>`, else None."""
    parts = key.split("/")
    if len(parts) == 3 and re.fullmatch(r"f|[1-9][0-9]*d", parts[0]) and re.fullmatch(r"[0-9a-f]{10}", parts[1]) and parts[2]:
        return tuple(parts)
    return None


def expiry_days(prefix):
    """How many days after upload R2 deletes a file in this folder, or None for `f`, which keeps its files."""
    return int(prefix[:-1]) if prefix.endswith("d") else None


def days_text(days):
    return "1 day" if days == 1 else "%d days" % days


def day(stamp):
    return time.strftime("%Y-%m-%d", time.localtime(stamp))


def parse_xml(body):
    """An S3 answer as an element tree, with the S3 namespace dropped from every tag."""
    root = ElementTree.fromstring(body)
    for element in root.iter():
        element.tag = element.tag.rsplit("}", 1)[-1]
    return root


def config_path():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "share" / "r2.json"


def save_config(config):
    """Writes the R2 settings where only you can read them."""
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as handle:
        json.dump(config, handle, indent=2)
    os.chmod(path, 0o600)


def r2_config():
    """The stored R2 settings, or None when there are none or SHARE_BACKEND=github asks for GitHub."""
    path = config_path()
    if os.environ.get("SHARE_BACKEND") == "github" or not path.exists():
        return None
    try:
        config = json.loads(path.read_text())
    except ValueError as error:
        die("%s is not valid JSON (%s); run share --setup again" % (path, error))
    missing = [key for key in R2_KEYS if not config.get(key)]
    if missing:
        die("%s has no %s; run share --setup again" % (path, ", ".join(missing)))
    return config


def content_type(path, name):
    """The type R2 serves a file as. Pictures, video, sound and PDFs keep their own. Any other file that
    reads as UTF-8 text is plain text, so a browser shows it rather than saving it, and never runs it as
    a web page."""
    guessed = mimetypes.guess_type(name)[0] or "application/octet-stream"
    if guessed.split("/")[0] in ("image", "video", "audio") or guessed == "application/pdf":
        return guessed
    with open(path, "rb") as handle:
        head = handle.read(64 * 1024)
    try:
        codecs.getincrementaldecoder("utf-8")().decode(head)  # not final, so a character cut at the end passes
    except UnicodeDecodeError:
        return guessed
    return guessed if b"\0" in head else "text/plain; charset=utf-8"


def disposition(name, original):
    """A Content-Disposition that keeps a file showing in the browser and, when it is saved, saves it under the
    name it had before clean_name, in the RFC 6266 form every browser reads."""
    value = 'inline; filename="%s"' % name
    if original and original != name:
        value += "; filename*=UTF-8''" + urllib.parse.quote(original, safe="")
    return value


def canonical_query(query):
    """A query string as SigV4 signs it, and so as it must be sent: names and values escaped, then sorted."""
    escape = lambda text: urllib.parse.quote(text, safe="-_.~")
    return "&".join("%s=%s" % pair for pair in sorted((escape(k), escape(v)) for k, v in query.items()))


def sigv4(method, path, query, headers, payload_hash, key_id, secret, stamp, region="auto", service="s3"):
    """The Authorization header for an AWS Signature Version 4 request, which is how R2's S3 API checks who asks.

    `path` is already escaped, `headers` has lower-case names and holds host and x-amz-date, and
    `stamp` is the x-amz-date value, such as 20150830T123600Z.
    """
    scope = "%s/%s/%s/aws4_request" % (stamp[:8], region, service)
    names = sorted(headers)
    canonical = "\n".join([
        method,
        path,
        canonical_query(query),
        "".join("%s:%s\n" % (name, " ".join(str(headers[name]).split())) for name in names),
        ";".join(names),
        payload_hash,
    ])
    to_sign = "\n".join(["AWS4-HMAC-SHA256", stamp, scope, hashlib.sha256(canonical.encode()).hexdigest()])
    key = ("AWS4" + secret).encode()
    for part in (stamp[:8], region, service, "aws4_request"):
        key = hmac.new(key, part.encode(), hashlib.sha256).digest()
    signature = hmac.new(key, to_sign.encode(), hashlib.sha256).hexdigest()
    return "AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s" % (key_id, scope, ";".join(names), signature)


def gh_login():
    """The gh login, read from gh's own config when it is there, which saves a call to the API."""
    login = run(["gh", "config", "get", "-h", "github.com", "user"], check=False).stdout.strip()
    return login or run(["gh", "api", "user", "--jq", ".login"]).stdout.strip()


# Set on Ctrl-C, so the uploads still going stop at their next read rather than run to the end.
stopping = threading.Event()


def in_parallel(work, things):
    """`work` on each of `things`, a few at a time, as a list in the same order. A die() in one ends the program."""
    pool = ThreadPoolExecutor(WORKERS)
    try:
        return list(pool.map(work, things))
    except BaseException:
        stopping.set()
        raise
    finally:
        pool.shutdown(cancel_futures=True)


class Progress:
    """One line on stderr with how much of an upload has gone, for uploads big enough to wait on."""

    def __init__(self, total):
        self.total, self.done = total, 0
        self.show = total >= PROGRESS_BYTES and sys.stderr.isatty()
        self.started = self.shown = time.time()
        self.lock = threading.Lock()

    def add(self, count):
        with self.lock:
            self.done += count
            now = time.time()
            if self.show and now - self.shown >= 0.25:
                self.shown = now
                rate = self.done / max(now - self.started, 0.001)
                sys.stderr.write("\r%3d%%  %s of %s  %s/s\033[K" % (
                    100 * self.done // self.total, human(self.done), human(self.total), human(rate)))
                sys.stderr.flush()

    def end(self):
        if self.show:
            sys.stderr.write("\r\033[K")
            sys.stderr.flush()


class Slice:
    """`length` bytes of a file from `offset`, read as a request body, counted on `progress` as they go.
    rewind() starts it again for a retry."""

    def __init__(self, path, offset, length, progress):
        self.handle = open(path, "rb")
        self.offset, self.length, self.progress = offset, length, progress
        self.rewind()

    def rewind(self):
        if getattr(self, "sent", 0):
            self.progress.add(-self.sent)
        self.handle.seek(self.offset)
        self.left, self.sent = self.length, 0

    def read(self, size=-1):
        if stopping.is_set():
            raise KeyboardInterrupt
        data = self.handle.read(self.left if size < 0 else min(size, self.left))
        self.left -= len(data)
        self.sent += len(data)
        self.progress.add(len(data))
        return data

    def close(self):
        self.handle.close()


def file_sha256(path, offset=0, length=None):
    """The SHA-256 of `length` bytes of a file from `offset`, or of all of it."""
    digest = hashlib.sha256()
    left = os.path.getsize(path) - offset if length is None else length
    with open(path, "rb") as handle:
        handle.seek(offset)
        while left > 0:
            chunk = handle.read(min(1 << 20, left))
            if not chunk:
                break
            digest.update(chunk)
            left -= len(chunk)
    return digest.hexdigest()


class Site:
    """The clone of the share repo and the Pages site built from it."""

    def __init__(self):
        self.repo = os.environ.get("SHARE_REPO") or "%s/share" % gh_login()
        self.owner, self.name = self.repo.split("/")
        cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
        self.clone = cache / "share" / self.name
        self.base = "https://%s.github.io/%s/" % (self.owner, self.name)
        self.branch = "main"

    def url(self, prefix, ident, name):
        return link(self.base, prefix, ident, name)

    def api(self, path):
        """The JSON gh gets for an API path, or {} if the call fails, so a poll that misses an answer tries again."""
        done = run(["gh", "api", path], check=False)
        try:
            return json.loads(done.stdout or "{}")
        except ValueError:
            return {}

    def sync(self):
        """Makes the local clone match the remote, making the repo and its Pages site the first time."""
        if not (self.clone / ".git").is_dir():
            if run(["gh", "repo", "view", self.repo], check=False).returncode:
                say("making the public repo %s (first use)" % self.repo)
                run(["gh", "repo", "create", self.repo, "--public", "--add-readme", "--description", "Files shared by link"])
            self.clone.parent.mkdir(parents=True, exist_ok=True)
            run(["gh", "repo", "clone", self.repo, str(self.clone), "--", "-q"])
        else:
            git(self.clone, "fetch", "-q", "origin")
        head = git(self.clone, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False).stdout.strip()
        self.branch = head.split("/", 1)[1] if "/" in head else "main"
        git(self.clone, "checkout", "-q", "-f", "-B", self.branch, "origin/" + self.branch)
        # The workflow is the last thing set up, so once it is in the repo there is nothing to check.
        if not (self.clone / WORKFLOW_PATH).exists():
            self.set_up_pages()

    def set_up_pages(self):
        """Has Pages deploy with the one-job workflow: on first use, and once for a repo made when `share` used the branch build."""
        say("setting up GitHub Pages to deploy in one job (once)")
        # Without this, a branch build's Jekyll skips any file whose name starts with `_` or `.`.
        if not (self.clone / ".nojekyll").exists():
            (self.clone / ".nojekyll").write_text("")
            (self.clone / "README.md").write_text(README)
        workflow = self.clone / WORKFLOW_PATH
        workflow.parent.mkdir(parents=True, exist_ok=True)
        workflow.write_text(WORKFLOW % self.branch)
        git(self.clone, "add", "-A")
        endpoint = ["gh", "api", "repos/%s/pages" % self.repo]
        pages = run(endpoint, check=False)
        undo = None
        if pages.returncode:
            run(endpoint + ["-X", "POST", "-f", "build_type=workflow"])
        elif json.loads(pages.stdout).get("build_type") != "workflow":
            # Back to the branch build if the push fails, or nothing would deploy until the workflow lands.
            undo = lambda: run(endpoint + ["-X", "PUT", "-f", "build_type=legacy"], check=False)
            run(endpoint + ["-X", "PUT", "-f", "build_type=workflow"])
        self.commit_and_push("deploy every file as it is, in one job", undo)

    def commit_and_push(self, message, undo=None):
        """One commit, pushed; if the push fails the clone goes back to the remote so it is never left ahead, and `undo` runs."""
        git(self.clone, "commit", "-q", "-m", message)
        pushed = git(self.clone, "push", "-q", "origin", "HEAD:" + self.branch, check=False)
        if pushed.returncode:
            git(self.clone, "reset", "-q", "--hard", "origin/" + self.branch)
            if undo:
                undo()
            die("the push failed: %s" % pushed.stderr.strip())
        return git(self.clone, "rev-parse", "HEAD").stdout.strip()

    def wait_for_build(self, sha):
        """Waits for Pages to deploy this commit. True when it is live, False if it is not after three minutes."""
        say("waiting for GitHub Pages to deploy...")
        started = time.time()
        polls = 0
        while time.time() - started < BUILD_TIMEOUT:
            # "succeed" comes after the CDN is purged, so the link answers at once.
            status = self.api("repos/%s/pages/deployments/%s" % (self.repo, sha)).get("status")
            if status == "succeed":
                say("live in %d s" % (time.time() - started))
                return True
            if status in DEPLOY_FAILED:
                die("the Pages deploy failed (%s)" % status)
            polls += 1
            # A run that fails before it deploys never shows above, so look at the run now and then.
            if polls % 5 == 0:
                runs = self.api("repos/%s/actions/runs?head_sha=%s" % (self.repo, sha)).get("workflow_runs") or []
                for done in runs:
                    # A newer push took its place, and that build has these files too.
                    if done.get("conclusion") == "cancelled":
                        return False
                    if done.get("status") == "completed" and done.get("conclusion") != "success":
                        die("the Pages run ended with %s: %s" % (done.get("conclusion"), done.get("html_url")))
            time.sleep(1)
        return False

    def files(self):
        """Every file that is up, as Entry, in name order. A file went up with the newest commit that touched it."""
        added, stamp = {}, 0
        for line in git(self.clone, "log", "--format=%at", "--name-only", "--", "f").stdout.splitlines():
            if line.startswith("f/"):
                added.setdefault(line, stamp)
            elif line.strip():
                stamp = int(line)
        found = []
        for path in sorted((self.clone / "f").glob("*/*")):
            key = path.relative_to(self.clone).as_posix()
            if path.is_file() and parse_key(key):
                found.append(Entry("f", path.parent.name, path.name, path.stat().st_size, added.get(key, 0)))
        return found

    def upload(self, items, wait):
        """Commits and pushes the files that are not up yet. False if `wait` and the deploy is still running after three minutes."""
        added = []
        for item in items:
            target = self.clone / item.prefix / item.ident / item.name
            if not target.exists():
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(item.path, target)
                added.append(item.name)
        if not added:
            return True
        say("uploading %s" % ", ".join(added))
        git(self.clone, "add", "-A")
        sha = self.commit_and_push(("add " + ", ".join(added))[:120])
        return not wait or self.wait_for_build(sha)

    def remove(self, doomed, wait):
        """Takes these files (Entry) down, from the history too."""
        kept = {}
        for entry in self.files():
            if entry not in doomed:
                kept.setdefault(entry.modified or int(time.time()), []).append(
                    "%s/%s/%s" % (entry.prefix, entry.ident, entry.name))
        for entry in doomed:
            git(self.clone, "rm", "-q", "%s/%s/%s" % (entry.prefix, entry.ident, entry.name))
        # A fresh history of what is left, so the removed bytes leave the branch too: one commit for the site, then
        # one per upload time, dated then, so --list still knows when each file went up.
        git(self.clone, "checkout", "-q", "--orphan", "_rewrite")
        git(self.clone, "rm", "-r", "-q", "--cached", "f", check=False)
        git(self.clone, "commit", "-q", "--allow-empty", "-m", "share files")
        for stamp in sorted(kept):
            git(self.clone, "add", *kept[stamp])
            git(self.clone, "commit", "-q", "--date=@%d" % stamp, "-m", "add " + ", ".join(
                path.rsplit("/", 1)[1] for path in kept[stamp])[:120])
        git(self.clone, "branch", "-q", "-M", self.branch)
        pushed = git(self.clone, "push", "-q", "-f", "origin", self.branch, check=False)
        if pushed.returncode:
            git(self.clone, "reset", "-q", "--hard", "origin/" + self.branch)
            die("the push failed: %s" % pushed.stderr.strip())
        sha = git(self.clone, "rev-parse", "HEAD").stdout.strip()
        say("removed %d file(s) from the repo and its history" % len(doomed))
        say("GitHub may serve the old commit by its SHA until it cleans up")
        if wait:
            self.wait_for_build(sha)


class Bucket:
    """A Cloudflare R2 bucket behind your own domain, reached with its S3 API. A file answers the moment its upload ends."""

    def __init__(self, config):
        self.host = urllib.parse.urlsplit(config["endpoint"]).netloc
        self.bucket = config["bucket"]
        self.key_id, self.secret = config["access_key_id"], config["secret_access_key"]
        self.base = config["public_url"].rstrip("/") + "/"
        self.zone_id, self.purge_token = config.get("zone_id"), config.get("purge_token")

    def url(self, prefix, ident, name):
        return link(self.base, prefix, ident, name)

    def purge(self, urls):
        """Drops these links from Cloudflare's cache. True if it did; a failure only warns, as the files are gone already."""
        for start in range(0, len(urls), 30):  # Cloudflare takes at most 30 links a call
            request = urllib.request.Request(
                "https://api.cloudflare.com/client/v4/zones/%s/purge_cache" % self.zone_id, method="POST",
                data=json.dumps({"files": urls[start:start + 30]}).encode(),
                headers=dict(USER_AGENT, **{"Authorization": "Bearer " + self.purge_token, "Content-Type": "application/json"}))
            try:
                urllib.request.urlopen(request, timeout=30).close()
            except urllib.error.HTTPError as error:
                say("share: Cloudflare would not purge its cache (%s)" % cloudflare_reason(error))
                return False
            except urllib.error.URLError as error:
                say("share: cannot reach Cloudflare to purge its cache: %s" % error.reason)
                return False
        return True

    def request(self, method, key="", query=None, body=None, digest=EMPTY_SHA256, headers=None, tries=3):
        """One signed request, as (status, body, headers). A 404 comes back. A dropped connection or an error on
        R2's side is tried again, up to `tries` times in all; any other failure ends the program with R2's reason."""
        query = query or {}
        path = "/" + self.bucket + ("/" + urllib.parse.quote(key) if key else "")
        url = "https://%s%s" % (self.host, path) + ("?" + canonical_query(query) if query else "")
        for attempt in range(1, tries + 1):
            stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
            signed = dict(headers or {}, **{"host": self.host, "x-amz-content-sha256": digest, "x-amz-date": stamp})
            signed["authorization"] = sigv4(method, path, query, signed, digest, self.key_id, self.secret, stamp)
            del signed["host"]  # urllib sends it from the URL
            try:
                # With a file for the body and Content-Length set, urllib streams it rather than chunking it.
                request = urllib.request.Request(url, data=body, method=method, headers=signed)
                with urllib.request.urlopen(request, timeout=60) as reply:
                    return reply.status, reply.read(), reply.headers
            except urllib.error.HTTPError as error:
                if error.code == 404:
                    return 404, b"", error.headers
                reason = s3_reason(error)
                if error.code < 500 or attempt == tries:
                    die("R2 refused %s %s: %s" % (method, key or "the bucket", reason))
            except (OSError, http.client.HTTPException) as error:  # URLError, a timeout or a cut in mid-transfer
                reason = getattr(error, "reason", error)
                if attempt == tries:
                    die("cannot reach R2 at %s: %s" % (self.host, reason))
            say("share: %s %s failed (%s); trying again" % (method, key or "the bucket", reason))
            if hasattr(body, "rewind"):
                body.rewind()
            time.sleep(2 ** attempt)

    def files(self):
        """Every file that is up, as Entry, in key order."""
        found, query = [], {"list-type": "2"}
        while True:
            status, body, _ = self.request("GET", query=query)
            if status == 404:
                die("there is no bucket %s; make it in the Cloudflare dashboard" % self.bucket)
            root = parse_xml(body)
            for item in root.iter("Contents"):
                parts = parse_key(item.findtext("Key"))
                if parts:
                    stamp = item.findtext("LastModified") or ""
                    modified = calendar.timegm(time.strptime(stamp[:19], "%Y-%m-%dT%H:%M:%S")) if stamp else 0
                    found.append(Entry(*parts, int(item.findtext("Size")), modified))
            token = root.findtext("NextContinuationToken")
            if root.findtext("IsTruncated") != "true" or not token:
                return found
            query = dict(query, **{"continuation-token": token})

    def upload(self, items, wait):
        """Puts each file that is not up yet, a few at a time. Always True: there is no build to wait for."""
        items = list({self.key(item): item for item in items}.values())  # the same file named twice goes up once
        heads = in_parallel(lambda item: self.request("HEAD", self.key(item)), items)
        new = [item for item, head in zip(items, heads) if head[0] == 404]
        for item, (status, _, headers) in zip(items, heads):
            days = expiry_days(item.prefix)
            if status != 404 and days and headers.get("Last-Modified"):
                since = calendar.timegm(time.strptime(headers["Last-Modified"], "%a, %d %b %Y %H:%M:%S GMT"))
                say("note: %s went up on %s, so it is deleted about %s" % (item.name, day(since), day(since + days * 86400)))
        if not new:
            return True
        say("uploading %s" % ", ".join(item.name for item in new))
        progress = Progress(sum(item.size for item in new))
        in_parallel(lambda item: self.put(item, progress), new)
        progress.end()
        days = expiry_days(new[0].prefix)
        if days:
            say("R2 deletes %s about %s, %s from now (it can take up to a day longer)"
                % (", ".join(item.name for item in new), day(time.time() + days * 86400), days_text(days)))
        # Cloudflare caches a 404 too, so a file shared again after --rm would answer 404 for a few minutes.
        if self.zone_id and self.purge_token:
            self.purge([self.url(item.prefix, item.ident, item.name) for item in new])
        return True

    @staticmethod
    def key(item):
        return "%s/%s/%s" % (item.prefix, item.ident, item.name)

    def put(self, item, progress):
        """Puts one file: in one request, or in parts when it is big."""
        headers = {
            "cache-control": R2_CACHE_CONTROL,
            "content-disposition": disposition(item.name, item.original),
            "content-type": content_type(item.path, item.name),
        }
        if item.size > MULTIPART_BYTES:
            return self.put_parts(item, headers, progress)
        body = Slice(item.path, 0, item.size, progress)
        try:
            self.request("PUT", self.key(item), body=body, digest=item.digest,
                         headers=dict(headers, **{"content-length": str(item.size)}), tries=4)
        finally:
            body.close()

    def put_parts(self, item, headers, progress):
        """Puts a big file in parts. An upload of the same file that an earlier run left unfinished goes on from
        the parts R2 already has, which it keeps for 7 days."""
        key, size = self.key(item), item.size
        part = part_bytes(size)
        count = -(-size // part)
        upload_id, have = self.unfinished(key)
        if upload_id:
            have = {n: etag for n, (etag, length) in have.items() if length == min(part, size - (n - 1) * part)}
            say("going on with %s: R2 has %d of its %d parts" % (item.name, len(have), count))
        else:
            reply = self.request("POST", key, query={"uploads": ""}, headers=headers)[1]
            upload_id, have = parse_xml(reply).findtext("UploadId"), {}
        etags = {}
        for number in range(1, count + 1):
            offset = (number - 1) * part
            length = min(part, size - offset)
            if number in have:
                etags[number] = have[number]
                progress.add(length)
                continue
            body = Slice(item.path, offset, length, progress)
            try:
                reply = self.request("PUT", key, query={"partNumber": str(number), "uploadId": upload_id}, body=body,
                                     digest=file_sha256(item.path, offset, length),
                                     headers={"content-length": str(length)}, tries=4)
            finally:
                body.close()
            etags[number] = reply[2]["ETag"]
        done = "<CompleteMultipartUpload>%s</CompleteMultipartUpload>" % "".join(
            "<Part><PartNumber>%d</PartNumber><ETag>%s</ETag></Part>" % (n, etags[n]) for n in sorted(etags))
        reply = self.request("POST", key, query={"uploadId": upload_id}, body=done.encode(),
                             digest=hashlib.sha256(done.encode()).hexdigest())[1]
        root = parse_xml(reply)
        if root.tag == "Error":  # S3 can answer 200 and still fail
            die("R2 could not put %s together: %s: %s" % (item.name, root.findtext("Code"), root.findtext("Message")))

    def unfinished(self, key):
        """The id of an unfinished upload of this key and its parts as {number: (etag, size)}, or (None, {})."""
        root = parse_xml(self.request("GET", query={"uploads": "", "prefix": key})[1])
        uploads = sorted((u.findtext("Initiated") or "", u.findtext("UploadId"))
                         for u in root.iter("Upload") if u.findtext("Key") == key)
        if not uploads:
            return None, {}
        upload_id, parts, query = uploads[-1][1], {}, {"uploadId": uploads[-1][1]}
        while True:
            status, body, _ = self.request("GET", key, query=query)
            if status == 404:
                return None, {}
            root = parse_xml(body)
            for each in root.iter("Part"):
                parts[int(each.findtext("PartNumber"))] = (each.findtext("ETag"), int(each.findtext("Size")))
            marker = root.findtext("NextPartNumberMarker")
            if root.findtext("IsTruncated") != "true" or not marker:
                return upload_id, parts
            query = dict(query, **{"part-number-marker": marker})

    def remove(self, doomed, wait):
        """Takes these files (Entry) down."""
        for entry in doomed:
            self.request("DELETE", "%s/%s/%s" % (entry.prefix, entry.ident, entry.name))
        say("removed %d file(s)" % len(doomed))
        if self.zone_id and self.purge_token and self.purge([self.url(e.prefix, e.ident, e.name) for e in doomed]):
            say("and purged from Cloudflare's cache; a browser that already opened one may still show it")
        else:
            say("Cloudflare's cache may serve them for up to an hour")


def part_bytes(size):
    """The size of each part but the last: 16 MB, or more when 10,000 parts would not hold the file."""
    needed = -(-size // MAX_PARTS)
    return PART_BYTES if needed <= PART_BYTES else -(-needed // 1024**2) * 1024**2


def cloudflare_reason(error):
    """The Cloudflare API's own words for a failed call, or the HTTP status."""
    try:
        errors = json.loads(error.read()).get("errors") or []
    except ValueError:
        errors = []
    return "; ".join("%s %s" % (e.get("code"), e.get("message")) for e in errors) or "HTTP %d" % error.code


def s3_reason(error):
    """R2's own words for a failed request, such as "SignatureDoesNotMatch: ...", or the HTTP status."""
    try:
        root = ElementTree.fromstring(error.read())
    except ElementTree.ParseError:
        root = None
    if root is None or not root.findtext("Code"):
        return "HTTP %d" % error.code
    return "%s: %s" % (root.findtext("Code"), root.findtext("Message"))


def work_dir():
    """A folder for the copies made before an upload, beside the cache rather than in /tmp, which may be RAM."""
    base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "share"
    base.mkdir(parents=True, exist_ok=True)
    return tempfile.TemporaryDirectory(dir=base, prefix="work-")


def exif_orientation(tiff):
    """The Orientation (1 to 8) in an Exif block's TIFF data, or 1 when it has none."""
    try:
        order = "<" if tiff[:2] == b"II" else ">"
        ifd = struct.unpack(order + "I", tiff[4:8])[0]
        for n in range(struct.unpack(order + "H", tiff[ifd:ifd + 2])[0]):
            entry = ifd + 2 + 12 * n
            if struct.unpack(order + "H", tiff[entry:entry + 2])[0] == 0x0112:
                return struct.unpack(order + "H", tiff[entry + 8:entry + 10])[0]
    except struct.error:
        pass
    return 1


def strip_jpeg(data):
    """A JPEG without its metadata: no Exif (so no place, time or camera), XMP, IPTC, comments or the extra pictures
    some phones add after the end. The colour profile stays, and so does the orientation, so the picture stands
    the right way up."""
    if data[:2] != b"\xff\xd8":
        raise ValueError("not a JPEG")
    out, i, orientation = [], 2, 1
    while i < len(data):
        if data[i] != 0xFF:
            raise ValueError("broken JPEG")
        marker = data[i + 1]
        if marker == 0xFF:  # fill byte
            i += 1
            continue
        if marker == 0xD9:  # end of the picture; anything after it goes
            out.append(b"\xff\xd9")
            break
        if 0xD0 <= marker <= 0xD7 or marker == 0x01:
            out.append(data[i:i + 2])
            i += 2
            continue
        end = i + 2 + int.from_bytes(data[i + 2:i + 4], "big")
        segment = data[i:end]
        if marker == 0xDA:  # a scan: its coded data runs to the next marker that is not a stuffed 0 or a restart
            while True:
                end = data.find(b"\xff", end)
                if end < 0 or end + 1 >= len(data):
                    end = len(data)
                    break
                if data[end + 1] == 0 or 0xD0 <= data[end + 1] <= 0xD7:
                    end += 2
                    continue
                break
            out.append(data[i:end])
        elif 0xE0 <= marker <= 0xEF or marker == 0xFE:
            if marker == 0xE1 and segment[4:10] == b"Exif\0\0":
                orientation = exif_orientation(segment[10:])
            if any(marker == m and segment[4:4 + len(start)] == start for m, start in JPEG_KEEP):
                out.append(segment)
        else:
            out.append(segment)
        i = end
    head = [b"\xff\xd8"]
    if orientation != 1:
        tiff = b"MM\0*" + struct.pack(">IHHHIHHI", 8, 1, 0x0112, 3, 1, orientation, 0, 0)
        head.append(b"\xff\xe1" + struct.pack(">H", len(tiff) + 8) + b"Exif\0\0" + tiff)
    if out and out[0][2:4] and out[0][:2] == b"\xff\xe0":  # JFIF wants to come first
        head.insert(1, out.pop(0))
    return b"".join(head + out)


def strip_png(data):
    """A PNG without its text, date and Exif chunks. The colour profile and the picture stay."""
    if data[:8] != PNG_SIGNATURE:
        raise ValueError("not a PNG")
    out, i = [data[:8]], 8
    while i + 12 <= len(data):
        length, kind = struct.unpack(">I4s", data[i:i + 8])
        if kind not in PNG_DROP:
            out.append(data[i:i + 12 + length])
        i += 12 + length
        if kind == b"IEND":
            break
    return b"".join(out)


def exiftool_writes():
    """The file extensions exiftool can write, or an empty set without exiftool."""
    if not hasattr(exiftool_writes, "found"):
        listed = run(["exiftool", "-listwf"], check=False).stdout if shutil.which("exiftool") else ""
        exiftool_writes.found = {"." + ext.lower() for ext in listed.split()[3:] if ext.isalnum()}
    return exiftool_writes.found


def media_kind(path):
    """"image" or "video" for a picture or video by its name (and, for .ts, its first bytes), else None. An SVG is no picture here: it is a page
    that can hold scripts, and has no camera metadata."""
    suffix = path.suffix.lower()
    if suffix in RAW_PHOTOS:
        return "image"
    if suffix in CAMERA_VIDEO:
        return "video"
    if suffix == ".ts":  # MPEG-TS video, as dashcams record, or TypeScript: a sync byte every 188 bytes says video
        with open(path, "rb") as handle:
            head = handle.read(189)
        return "video" if head[:1] == head[188:189] == b"\x47" else None
    kind = mimetypes.guess_type(path.name)[0] or ""
    if kind == "image/svg+xml" or kind.split("/")[0] not in ("image", "video"):
        return None
    return kind.split("/")[0]


def without_sei(info, videos):
    """The ffmpeg arguments that drop the SEI messages from each H.264 stream copied out of an MPEG-TS file, where
    camcorders and dashcams keep the time and place. `videos` are the video streams in the order they go out."""
    if (info.get("format") or {}).get("format_name") != "mpegts":
        return []
    return sum((["-bsf:v:%d" % n, "filter_units=remove_types=6"]
                for n, stream in enumerate(videos) if stream.get("codec_name") == "h264"), [])


def strip_video(path, target):
    """Copy a video's picture and sound to `target` and nothing else: no metadata, so no place, camera or dates
    (the file's own times come out as zero), and no other tracks, such as the GPS route drones and action
    cameras record beside the video. Camcorders keep the time and place inside the H.264 stream, in SEI
    messages, which go too. Rotation stays, and nothing is encoded again."""
    info, read = open_video(path)
    command = ["ffmpeg", "-nostdin", "-v", "error", "-y"] + read + [
        "-map", "0:v?", "-map", "0:a?", "-c", "copy", "-map_metadata", "-1", "-map_chapters", "-1",
        "-fflags", "+bitexact"]
    command += without_sei(info, [s for s in info.get("streams") or [] if s.get("codec_type") == "video"])
    if target.suffix.lower() in (".mp4", ".m4v", ".mov"):
        command += ["-movflags", "+faststart"]
    done = run(command + [str(target)], check=False)
    if done.returncode or not target.exists():
        die("ffmpeg could not strip %s: %s\n--keep-metadata puts it up as it is" % (path.name, done.stderr.strip()))


def strip_metadata(path, folder):
    """A copy of a picture or video without where and when it was taken or on what, in `folder`; the file itself
    if it has nothing to strip or nothing here can strip it. Videos go through ffmpeg. Pictures go through
    exiftool when it is installed, which knows nearly every format, else the JPEG and PNG stripping above."""
    kind = media_kind(path)
    if not kind:
        return path
    target = folder / path.name
    if kind == "video":
        if not (shutil.which("ffmpeg") and shutil.which("ffprobe")):
            say("note: %s keeps its metadata, such as where it was taken; install ffmpeg to strip it" % path.name)
            return path
        strip_video(path, target)
        return target
    if path.suffix.lower() in exiftool_writes():
        done = run(["exiftool", "-q", "-q", "-all=", "--icc_profile:all", "-tagsfromfile", "@", "-colorspacetags",
                    "-orientation", "-o", str(target), str(path)], check=False)
        if done.returncode or not target.exists():
            die("exiftool could not strip %s: %s\n--keep-metadata puts it up as it is"
                % (path.name, (done.stderr or done.stdout).strip()))
        if path.suffix.lower() in RAW_PHOTOS:  # exiftool will not delete what raw converters need to read them
            say("note: %s goes up without its place, but a RAW photo keeps its date and camera" % path.name)
        return target
    strip = {".jpg": strip_jpeg, ".jpeg": strip_jpeg, ".png": strip_png}.get(path.suffix.lower())
    if not strip:
        hint = "" if shutil.which("exiftool") else "; install exiftool to strip it"
        say("note: %s keeps its metadata, such as where it was taken%s" % (path.name, hint))
        return path
    try:
        target.write_bytes(strip(path.read_bytes()))
    except ValueError as error:
        die("cannot strip %s (%s)\n--keep-metadata puts it up as it is" % (path.name, error))
    return target


def probe(path):
    """What ffprobe says about a video's format, streams and length, or {}. It may open local files only, so a
    playlist cannot make it fetch a URL."""
    done = run(["ffprobe", "-v", "error", "-protocol_whitelist", "file", "-show_streams", "-show_format",
                "-of", "json", str(path)], check=False)
    try:
        return json.loads(done.stdout or "{}")
    except ValueError:
        return {}


def open_video(path):
    """What ffprobe says about a video, and the ffmpeg arguments that read it in the format ffprobe found. Stops
    if that is no format in VIDEO_FORMATS, such as a playlist made to look like a video."""
    info = probe(path)
    found = (info.get("format") or {}).get("format_name") or ""
    if found.split(",")[0] not in VIDEO_FORMATS:
        die("%s is not a video file ffmpeg should read (ffprobe reads it as %s)\n"
            "--keep-metadata, without --mp4, puts it up as it is" % (path.name, found or "nothing"))
    return info, ["-protocol_whitelist", "file", "-f", found.split(",")[0], "-i", str(path)]


def to_mp4(path, folder):
    """An mp4 of a video in `folder` that every browser plays inline: H.264 in 4:2:0 with AAC sound, its index at
    the start so it plays while it loads, and no metadata. A stream that already fits is copied, not encoded
    again. None when the file is no video or already plays as it is."""
    if media_kind(path) != "video" or path.suffix.lower() == ".webm":
        return None
    if not (shutil.which("ffmpeg") and shutil.which("ffprobe")):
        die("--mp4 needs ffmpeg; install it with your package manager")
    info, read = open_video(path)
    streams = info.get("streams") or []
    video = next((s for s in streams if s.get("codec_type") == "video"
                  and not (s.get("disposition") or {}).get("attached_pic")), None)
    if not video:
        return None
    audio = next((s for s in streams if s.get("codec_type") == "audio"), None)
    video_ok = video.get("codec_name") == "h264" and video.get("pix_fmt") == "yuv420p"
    audio_ok = audio is None or audio.get("codec_name") == "aac"
    if path.suffix.lower() in (".mp4", ".m4v") and video_ok and audio_ok:
        return None
    target = folder / (path.stem + ".mp4")
    command = ["ffmpeg", "-nostdin", "-v", "error", "-y"] + read + ["-map", "0:%d" % video["index"], "-map", "0:a:0?",
                                                                    "-map_metadata", "-1", "-map_chapters", "-1"]
    command += ["-c:v", "copy"] + without_sei(info, [video]) if video_ok else [
        "-c:v", "libx264", "-preset", "veryfast", "-crf", "23", "-pix_fmt", "yuv420p",
        "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2"]  # 4:2:0 needs an even width and height
    command += ["-c:a", "copy"] if audio_ok else ["-c:a", "aac", "-b:a", "160k"]
    command += ["-movflags", "+faststart", "-progress", "pipe:1", "-nostats", str(target)]
    say("converting %s to mp4%s" % (path.name, " (copying the video, which plays already)" if video_ok else ""))
    length = float((info.get("format") or {}).get("duration") or 0)
    show = length > 0 and sys.stderr.isatty()
    with tempfile.TemporaryFile("w+") as errors:  # not a pipe: a damaged file's errors could fill one and stall ffmpeg
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors, text=True)
        for line in process.stdout:
            if show and line.startswith("out_time_us=") and line[12:].strip().isdigit():
                sys.stderr.write("\r%3d%%\033[K" % min(100, int(line[12:]) / 1e6 / length * 100))
                sys.stderr.flush()
        process.wait()
        errors.seek(0)
        error = errors.read()
    if show:
        sys.stderr.write("\r\033[K")
    if process.wait():
        die("ffmpeg could not convert %s: %s" % (path.name, error.strip()))
    return target


def sniff_suffix(head):
    """A file extension for bytes with no name, such as a picture piped in, from how they start."""
    for start, suffix in ((PNG_SIGNATURE, ".png"), (b"\xff\xd8\xff", ".jpg"), (b"GIF8", ".gif"), (b"%PDF", ".pdf"),
                          (b"\x1aE\xdf\xa3", ".webm")):
        if head.startswith(start):
            return suffix
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return ".webp"
    if head[4:8] == b"ftyp":  # the ISO family: the brands after it say photo, sound or video
        brands = head[8:12] + head[16:32]
        if b"avif" in brands or b"avis" in brands:
            return ".avif"
        if head[8:12] in (b"heic", b"heix", b"heim", b"heis", b"hevc", b"hevx", b"mif1", b"msf1"):
            return ".heic"
        return {b"qt  ": ".mov", b"M4A ": ".m4a"}.get(head[8:12], ".mp4")
    try:
        codecs.getincrementaldecoder("utf-8")().decode(head)
    except UnicodeDecodeError:
        return ".bin"
    return ".bin" if b"\0" in head else ".txt"


def pasted_name(suffix):
    return "pasted-%s%s" % (time.strftime("%Y%m%d-%H%M%S"), suffix)


def from_stdin(folder):
    """What is piped in, as a file in `folder` named for when it came."""
    if sys.stdin.isatty():
        die("- reads a file piped in, such as `grim - | share -`, and nothing is")
    raw = folder / "stdin"
    with open(raw, "wb") as handle:
        shutil.copyfileobj(sys.stdin.buffer, handle)
    with open(raw, "rb") as handle:
        path = folder / pasted_name(sniff_suffix(handle.read(64)))
    raw.rename(path)
    return path


def from_clipboard(folder):
    """What `share` with no path shares: the files copied in a file manager, else a picture on the clipboard, such
    as a screenshot, as a file in `folder`. [] when it holds neither or there is no Wayland clipboard."""
    if not (os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-paste")):
        return []
    paste = lambda *args, **kwargs: subprocess.run(["wl-paste", "--no-newline", *args], timeout=10, **kwargs)
    try:
        types = paste("--list-types", capture_output=True, text=True).stdout.split()
        if "text/uri-list" in types:
            uris = [line.strip() for line in paste("--type", "text/uri-list", capture_output=True, text=True).stdout.splitlines()
                    if line.strip() and not line.startswith("#")]
            if uris and all(uri.startswith("file://") for uri in uris):
                return [Path(urllib.parse.unquote(urllib.parse.urlsplit(uri).path)) for uri in uris]
        picture = next((kind for kind in types if kind == "image/png"), None) or \
            next((kind for kind in types if kind.startswith("image/")), None)
        if not picture:
            return []
        path = folder / pasted_name(mimetypes.guess_extension(picture) or ".bin")
        with open(path, "wb") as handle:
            paste("--type", picture, stdout=handle, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return []
    return [path] if path.stat().st_size else []


def expiry_rule(config, days):
    """Makes sure R2 deletes files in `<days>d/` that many days after they go up. A bucket's lifecycle rules need a
    token the share settings do not hold, so this asks the Cloudflare CLI, once for each number of days."""
    if days in config.get("expire_days", []):
        return
    prefix = "%dd/" % days
    by_hand = ("or add it in the dashboard: R2 -> %s -> Settings -> Object Lifecycle Rules, prefix %s, delete "
               "objects %s after upload; then run this again with SHARE_EXPIRE_RULE_SET=1" % (config["bucket"], prefix, days_text(days)))
    if os.environ.get("SHARE_EXPIRE_RULE_SET") != "1":
        if not shutil.which("cf"):
            die("--expire needs a lifecycle rule on the bucket. Install the Cloudflare CLI (cf) and log in, " + by_hand)
        say("adding a lifecycle rule to %s: delete files in %s %s after upload (once)" % (config["bucket"], prefix, days_text(days)))
        env = dict(os.environ, CLOUDFLARE_ACCOUNT_ID=urllib.parse.urlsplit(config["endpoint"]).netloc.split(".")[0])
        cf = ["cf", "r2", "buckets", "lifecycle"]
        got = subprocess.run(cf + ["get", config["bucket"], "-q"], capture_output=True, text=True, env=env)
        try:
            rules = json.loads(got.stdout).get("rules") or []
        except ValueError:
            die("cf could not read the bucket's lifecycle rules: %s\nLog in with `cf auth login`, %s"
                % ((got.stderr or got.stdout).strip(), by_hand))
        rule_id = "share-expire-%dd" % days
        rules = [rule for rule in rules if rule.get("id") != rule_id] + [{
            "id": rule_id, "enabled": True, "conditions": {"prefix": prefix},
            "deleteObjectsTransition": {"condition": {"type": "Age", "maxAge": days * 86400}},
        }]
        put = subprocess.run(cf + ["update", config["bucket"], "--rules", json.dumps(rules), "-f", "-q"],
                             capture_output=True, text=True, env=env)
        if put.returncode:
            die("cf could not add the lifecycle rule: %s\nInstead, %s" % ((put.stderr or put.stdout).strip(), by_hand))
    config["expire_days"] = sorted(set(config.get("expire_days", [])) | {days})
    save_config(config)


def open_store():
    """Where the files go: the R2 bucket once it is set up, else the GitHub repo, synced."""
    config = r2_config()
    if config:
        return Bucket(config)
    site = Site()
    site.sync()
    return site


def check_live(url):
    """The content type if the link answers, else None. A few tries, because the CDN can lag a moment behind the build."""
    for attempt in range(5):
        try:
            request = urllib.request.Request(url, method="HEAD", headers=USER_AGENT)
            with urllib.request.urlopen(request, timeout=15) as reply:
                return reply.headers.get("content-type", "")
        except urllib.error.HTTPError as error:
            if error.code != 404:
                return None
        except urllib.error.URLError:
            pass
        time.sleep(2)
    return None


def copy_to_clipboard(text):
    """Best effort. wl-copy forks a server that can hold a captured pipe open, so it gets no pipes but its input."""
    if not (os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy")):
        return False
    try:
        subprocess.run(["wl-copy"], input=text.encode(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        return True
    except Exception:
        return False


def finish(links, copy, waiting=False):
    """Prints the links and copies them. `waiting` says some of them do not answer yet."""
    print("\n".join(links), flush=True)
    copied = copy and copy_to_clipboard("\n".join(links))
    if copied:
        say("copied to the clipboard")
    title = "%s %s" % ("Link" if len(links) == 1 else "%d links" % len(links), "copied" if copied else "shared")
    notify(title + ("; it may not work for another minute" if waiting else ""), "\n".join(links))


def cmd_share(paths, wait=True, copy=True, expire=None, mp4=False, keep_metadata=False):
    """Puts the files up and prints their links. `-` reads one from stdin, and no paths at all shares what is on the
    clipboard. With `expire`, a number of days, R2 deletes them that long after. `mp4` converts video that browsers
    may not play, and pictures and videos lose their metadata unless `keep_metadata`. False if there was nothing
    to share."""
    config = r2_config()
    if expire and not config:
        die("--expire needs Cloudflare R2 (see share --setup); GitHub Pages cannot delete a file on a timer")
    limit, rule = (R2_MAX_BYTES, "R2 takes at most 5 TB") if config else (MAX_BYTES, "GitHub takes at most 100 MB")
    prefix = "%dd" % expire if expire else "f"
    with work_dir() as work:
        work = Path(work)
        sources = [from_stdin(work) if raw == "-" else Path(raw).expanduser() for raw in paths] or from_clipboard(work)
        if not sources:
            return False
        too_big = lambda size, name: die("%s is %s and %s a file. Shrink it first, for example:\n"
                                         "  share --mp4 FILE, or ffmpeg -i FILE -crf 28 -vf scale=-2:720 smaller.mp4"
                                         % (name, human(size), rule))
        for path in sources:
            if not path.is_file():
                die("no such file: %s" % path)
            size = path.stat().st_size
            if size == 0:
                die("%s is empty" % path)
            # --mp4 may bring a video under the limit, so that waits until it is converted.
            if size > limit and not (mp4 and media_kind(path) == "video"):
                too_big(size, path.name)
        items = []
        for number, path in enumerate(sources):
            folder = work / str(number)
            folder.mkdir()
            original = path.name
            converted = to_mp4(path, folder) if mp4 else None
            if converted:
                path, original = converted, Path(original).stem + ".mp4"
            elif not keep_metadata:
                path = strip_metadata(path, folder)
            size = path.stat().st_size
            if size > limit:
                too_big(size, original)
            if size > WARN_BYTES:
                say("note: %s is %s, which is big for a link" % (original, human(size)))
            if path.suffix.lower() in OTHER_VIDEO:
                say("note: browsers play mp4 (H.264) and webm inline; %s may download instead. --mp4 converts it" % original)
            digest = file_sha256(path)
            items.append(Item(path, prefix, digest[:10], clean_name(original), digest, size, original))

        if expire:
            expiry_rule(config, expire)
        store = open_store()
        live = store.upload(items, wait)
    links = [store.url(item.prefix, item.ident, item.name) for item in items]
    waiting = not live
    if waiting:
        say("share: the build is still running, so the links may not work for another minute")
    elif wait:
        for each, kind in zip(links, in_parallel(check_live, links)):
            if kind is None:
                say("share: %s does not answer yet; try it again in a minute" % each)
                waiting = True
            else:
                say("ok  %s  (%s)" % (each.rsplit("/", 1)[-1], kind.split(";")[0]))
    finish(links, copy, waiting)
    return True


def cmd_list():
    """Every file that is up, newest first, with when it went up, its size and its link; then the total."""
    store = open_store()
    found = sorted(store.files(), key=lambda entry: entry.modified, reverse=True)
    if not found:
        say("nothing is up")
        return
    for entry in found:
        days = expiry_days(entry.prefix)
        until = "  (deleted about %s)" % day(entry.modified + days * 86400) if days else ""
        print("%s  %8s  %s%s" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(entry.modified)), human(entry.size),
                                 store.url(entry.prefix, entry.ident, entry.name), until))
    sys.stdout.flush()
    room = "R2's free tier holds 10 GB" if isinstance(store, Bucket) else "GitHub Pages holds about 1 GB"
    say("%d file(s), %s in all; %s" % (len(found), human(sum(entry.size for entry in found)), room))


def cmd_rm(targets, wait, yes=False):
    """Takes down what each target names. A target that names more than one file asks first, unless `yes`."""
    store = open_store()
    found = store.files()
    doomed, several = [], False
    for target in targets:
        match = re.search(r"/(f|[1-9][0-9]*d)/([0-9a-f]{10})/", target)
        if match:
            hits = [e for e in found if (e.prefix, e.ident) == match.groups()]
        else:
            hits = [e for e in found if target in (e.ident, e.name)]
        if not hits:
            die("nothing that is up matches %s" % target)
        doomed += [e for e in hits if e not in doomed]
        several = several or len(hits) > 1
    if several and not yes:
        say("that matches %d files:" % len(doomed))
        for entry in doomed:
            say("  " + store.url(entry.prefix, entry.ident, entry.name))
        if not sys.stdin.isatty():
            die("add --yes to take them all down")
        if input("take all %d down? [y/N] " % len(doomed)).strip().lower() not in ("y", "yes"):
            die("nothing was taken down")
    store.remove(doomed, wait)


def ask(prompt, default=""):
    answer = input("%s%s: " % (prompt, " [%s]" % default if default else "")).strip() or default
    if not answer:
        die("setup needs this; run share --setup again")
    return answer


def cmd_setup():
    """Asks for the R2 settings, checks them with one list of the bucket, then saves them where only you can read them."""
    path = config_path()
    try:
        old = json.loads(path.read_text())
    except (OSError, ValueError):
        old = {}
    say("Cloudflare R2 settings, from the R2 API token page. They go in %s, readable by you only." % path)
    endpoint = ask("S3 endpoint, like https://<account id>.r2.cloudflarestorage.com", old.get("endpoint", ""))
    parts = urllib.parse.urlsplit(endpoint if "://" in endpoint else "https://" + endpoint)
    config = {"endpoint": "https://" + parts.netloc}
    config["bucket"] = ask("Bucket", parts.path.strip("/").split("/")[0] or old.get("bucket", "share"))
    config["access_key_id"] = ask("Access Key ID", old.get("access_key_id", ""))
    secret = getpass.getpass("Secret Access Key (not shown%s): " % ("; Enter keeps the saved one" if old else "")).strip()
    config["secret_access_key"] = secret or old.get("secret_access_key", "")
    if not config["secret_access_key"]:
        die("setup needs the secret; run share --setup again")
    public = ask("Public URL, the bucket's custom domain, like https://share.example.com", old.get("public_url", ""))
    config["public_url"] = (public if "://" in public else "https://" + public).rstrip("/")
    say("Optional: a Cloudflare API token with Cache Purge on the domain's zone lets --rm clear the cache at once.")
    zone = input("Zone ID, from the domain's Overview page (Enter %s): " % ("keeps the saved one" if old.get("zone_id") else "skips")).strip()
    zone = zone or old.get("zone_id", "")
    if zone:
        token = getpass.getpass("Cache Purge token (not shown; Enter keeps the saved one): ").strip()
        config["zone_id"], config["purge_token"] = zone, token or old.get("purge_token", "")
    found = Bucket(config).files()  # ends the program with R2's reason if a setting is wrong
    say("R2 answered: %d file(s) in %s" % (len(found), config["bucket"]))
    try:
        urllib.request.urlopen(urllib.request.Request(config["public_url"], method="HEAD", headers=USER_AGENT), timeout=15)
    except urllib.error.HTTPError:
        pass  # any answer means the domain and its certificate work
    except urllib.error.URLError as error:
        say("note: %s does not answer yet (%s); check that the custom domain is Active" % (config["public_url"], error.reason))
    config["expire_days"] = old.get("expire_days", []) if old.get("endpoint") == config["endpoint"] and \
        old.get("bucket") == config["bucket"] else []
    if not config["expire_days"]:
        del config["expire_days"]
    save_config(config)
    say("saved; `share FILE` now puts files on %s" % config["public_url"])


def parse_days(text):
    """--expire's value, `7d` or `7`, as a number of days."""
    match = re.fullmatch(r"([1-9][0-9]{0,3})d?", text.strip().lower())
    if not match:
        raise argparse.ArgumentTypeError("give a number of days, such as 7d")
    return int(match.group(1))


def main():
    parser = argparse.ArgumentParser(
        prog="share", description=__doc__.split("\n\n")[0], epilog="\n".join(__doc__.split("\n\n")[1:]),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("paths", nargs="*", metavar="PATH",
                        help="files to put on the web; - reads one from stdin, and none shares what is on the clipboard")
    parser.add_argument("--list", action="store_true", help="list what is up, with links")
    parser.add_argument("--rm", nargs="+", metavar="TARGET", help="take files down: a link, an id or a file name")
    parser.add_argument("--setup", action="store_true", help="store Cloudflare R2 settings; from then on files go there")
    parser.add_argument("--expire", metavar="DAYS", type=parse_days,
                        help="R2 deletes the files this many days after upload, such as 7d (R2 only)")
    parser.add_argument("--mp4", action="store_true", help="convert video that browsers may not play inline to mp4")
    parser.add_argument("--keep-metadata", action="store_true",
                        help="leave pictures and videos as they are, with where and when they were taken")
    parser.add_argument("-y", "--yes", action="store_true", help="with --rm, take down every match without asking")
    parser.add_argument("--no-wait", action="store_true", help="print the links without waiting for the Pages build")
    parser.add_argument("--no-copy", action="store_true", help="leave the clipboard alone")
    args = parser.parse_args()
    if args.setup:
        cmd_setup()
    elif args.list:
        cmd_list()
    elif args.rm:
        cmd_rm(args.rm, not args.no_wait, args.yes)
    elif not cmd_share(args.paths, not args.no_wait, not args.no_copy, args.expire, args.mp4, args.keep_metadata):
        parser.print_help()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        say("\nshare: stopped; a big upload goes on from where it stopped when you share the file again")
        sys.exit(130)
